{
  "name": "payments-engine",
  "version": "1.0.0",
  "description": "Reliable payments processing engine (mini Stripe backend) with idempotency, double-entry ledger, webhooks, fraud rules and reconciliation",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx src/migrate-cli.ts",
    "reconcile": "tsx src/reconcile-cli.ts",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "bench": "tsx scripts/bench.ts",
    "chaos": "tsx scripts/chaos.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "autocannon": "^9.0.0",
    "fast-check": "^4.10.2",
    "jest": "^30.5.2",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  }
}
