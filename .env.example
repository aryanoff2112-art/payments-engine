DATABASE_URL=postgres://postgres:postgres@localhost:5432/payments
REDIS_URL=redis://localhost:6379
PORT=3000
FEE_BPS=290
WEBHOOK_MAX_ATTEMPTS=8

# Required in production (>= 32 chars). Protects /v1/admin/*. Generate: openssl rand -base64 48
ADMIN_API_KEY=
# Old API keys keep working this long after a rotation (seconds). Pass grace_seconds: 0 to revoke immediately.
API_KEY_ROTATION_GRACE_SEC=86400
# DEV/TEST ONLY. Allows http:// and private/loopback webhook targets. The server refuses to boot with this on in production.
WEBHOOK_ALLOW_PRIVATE_TARGETS=false
